# Copy this file to A:\trade\.env before running Docker Compose.
# Keep .env local; it is ignored by Git.

TZ=Asia/Shanghai
DOCKER_NETWORK_NAME=trade-infrastructure
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=3

# MySQL
MYSQL_IMAGE=mysql:8.0
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=trade_system
MYSQL_ROOT_PASSWORD=123456
MYSQL_USER=trade
MYSQL_PASSWORD=123456
MYSQL_VOLUME_NAME=trade-mysql-data

# Redis
REDIS_IMAGE=redis:7
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=123456
REDIS_VOLUME_NAME=trade-redis-data

# Prometheus
PROMETHEUS_IMAGE=prom/prometheus:v3.12.0
PROMETHEUS_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
PROMETHEUS_VOLUME_NAME=trade-prometheus-data
PROMETHEUS_VOLUME_EXTERNAL=false

# Grafana
GRAFANA_IMAGE=grafana/grafana:13.1.0
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=123456
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_VOLUME_NAME=trade-grafana-data
GRAFANA_VOLUME_EXTERNAL=false

# Database
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/ai_trade?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=

# Optional Redis hot-market-data cache
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_DATABASE=0
SPRING_DATA_REDIS_PASSWORD=
SPRING_DATA_REDIS_CONNECT_TIMEOUT=1s
SPRING_DATA_REDIS_TIMEOUT=1s

# Background-loop startup gates
TRADE_AUTOMATION_STORY_AUTO_START=false
TRADE_AUTOMATION_TRADING_AUTO_START=false
TRADE_AUTOMATION_POLYMARKET_AUTO_START=false

# OKX trading
TRADE_TRADING_ENABLED=false
TRADE_TRADING_WEBSOCKET_ENABLED=false
# Bounded market-event queue: drop-oldest, drop-latest, or block
TRADE_TRADING_EVENT_QUEUE_CAPACITY=1024
TRADE_TRADING_EVENT_QUEUE_FULL_POLICY=drop-oldest
TRADE_TRADING_EVENT_QUEUE_PUBLISH_TIMEOUT_MS=100
TRADE_TRADING_EVENT_QUEUE_POLL_TIMEOUT_MS=100
TRADE_TRADING_EVENT_QUEUE_SHUTDOWN_TIMEOUT_MS=5000
TRADE_TRADING_HOT_MARKET_CACHE_ENABLED=true
TRADE_TRADING_HOT_MARKET_CACHE_KEY_PREFIX=trade:trading:hot-market
TRADE_TRADING_HOT_MARKET_CACHE_SNAPSHOT_TTL_MS=120000
TRADE_TRADING_HOT_MARKET_CACHE_CANDLE_TTL_MS=10800000
TRADE_TRADING_HOT_MARKET_CACHE_CANDLE_LIMIT=200
TRADE_TRADING_HOT_MARKET_CACHE_RETRY_INTERVAL_MS=5000
OKX_ACCESS_KEY=
OKX_SECRET_KEY=
OKX_ACCESS_PASSPHRASE=
TRADE_OKX_PROXY_ENABLED=false
TRADE_OKX_PROXY_HOST=127.0.0.1
TRADE_OKX_PROXY_PORT=7897

# Polymarket
TRADE_POLYMARKET_ENABLED=false
TRADE_POLYMARKET_EXECUTION_ENABLED=false
TRADE_POLYMARKET_PROXY_ENABLED=false
TRADE_POLYMARKET_PROXY_HOST=127.0.0.1
TRADE_POLYMARKET_PROXY_PORT=7897
POLYMARKET_PRIVATE_KEY=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_ORDER_SCRIPT=../tools/polymarket/polymarket_place_order.py

# AI provider
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
MOONSHOT_API_KEY=
TRADE_AI_PROXY_ENABLED=false
TRADE_AI_PROXY_HOST=127.0.0.1
TRADE_AI_PROXY_PORT=7897

# Story generation
TRADE_STORY_ENABLED=false
TRADE_STORY_OUTPUT_DIR=../story
TRADE_STORY_TREND_PROXY_ENABLED=false
TRADE_STORY_TREND_PROXY_HOST=127.0.0.1
TRADE_STORY_TREND_PROXY_PORT=7897

# Marketplace and Aliyun OSS
TRADE_MARKETPLACE_SESSION_RETENTION_DAYS=30
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
TRADE_MARKETPLACE_OSS_ROLE_ARN=
TRADE_MARKETPLACE_OSS_BUCKET=
TRADE_MARKETPLACE_OSS_REGION=
TRADE_MARKETPLACE_OSS_PUBLIC_BASE_URL=
TRADE_MARKETPLACE_OSS_STS_ENDPOINT=https://sts.aliyuncs.com
TRADE_MARKETPLACE_OSS_DURATION_SECONDS=900
TRADE_MARKETPLACE_OSS_KEY_PREFIX=marketplace

# Text game and Weibo admin
TRADE_TEXT_GAME_ADMIN_TOKEN=
TRADE_TEXT_GAME_SEED_ENABLED=true
WEIBO_CLIENT_ID=
WEIBO_CLIENT_SECRET=
WEIBO_REDIRECT_URI=
TRADE_WEIBO_ADMIN_TOKEN=
TRADE_WEIBO_PROXY_ENABLED=false
TRADE_WEIBO_PROXY_HOST=127.0.0.1
TRADE_WEIBO_PROXY_PORT=7897

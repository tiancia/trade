# 环境变量示例；Spring Boot 不会自动加载本文件或普通 .env。
# 请在 IDE 运行配置或启动进程的环境中设置变量；修改后需重启应用，注释中的值仅解释本示例。
# 此文件保留常用环境变量；完整配置项及单位见 src/main/resources/application.yml。

# MySQL 数据库连接
# MySQL JDBC 连接地址，包含主机、端口、数据库名和连接参数；数据库须已存在。
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/trade_system?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
# 数据库登录用户；使用 Docker 时与基础设施的数据库用户配置一致。
SPRING_DATASOURCE_USERNAME=trade
# 数据库登录密码；使用 Docker 时与基础设施密码一致，示例值请按实际环境替换。
SPRING_DATASOURCE_PASSWORD=123456

# Redis 可选热行情缓存
# Redis 主机地址；仅用于可关闭的热行情缓存。
SPRING_DATA_REDIS_HOST=127.0.0.1
# Redis TCP 端口。
SPRING_DATA_REDIS_PORT=6379
# Redis 逻辑数据库编号。
SPRING_DATA_REDIS_DATABASE=0
# Redis 登录密码；与基础设施的 Redis 密码配置一致。
SPRING_DATA_REDIS_PASSWORD=123456
# Redis 建立连接超时，支持 s/ms 等单位；1s = 1 秒。
SPRING_DATA_REDIS_CONNECT_TIMEOUT=1s
# Redis 命令超时，支持 s/ms 等单位；1s = 1 秒。
SPRING_DATA_REDIS_TIMEOUT=1s

# 监控指标
# 监控指标的 environment 标签，用于区分本地、测试和生产环境。
TRADE_METRICS_ENVIRONMENT=local

# 后台任务启动
# auto-start 仅决定应用就绪后是否启动循环；模块开关与真实执行门禁还需分别开启。
# 定时循环采用 fixed delay：上一轮完成后再等待配置间隔；也可通过任务管理 API 手动启停。
# 应用就绪后是否启动小说生成循环；实际生成还需 TRADE_STORY_ENABLED=true。
TRADE_AUTOMATION_STORY_AUTO_START=false
# 应用就绪后是否启动交易的策略评估、事件扫描与对账循环；各能力另有门禁。
TRADE_AUTOMATION_TRADING_AUTO_START=false
# 应用就绪后是否启动 Polymarket 决策循环；实际决策还需模块开关开启。
TRADE_AUTOMATION_POLYMARKET_AUTO_START=false
# 应用就绪后是否启动微博生成、审核与发布循环；各工作流门禁仍分别生效。
TRADE_AUTOMATION_WEIBO_AUTO_START=false
# 应用就绪后是否启动 X 生成、审核与发布循环；false 时可通过任务管理 API 手动启动。
# 本示例为 false；当前 application.yml 未收到此环境变量时使用 true，不会自动读取本示例。
TRADE_AUTOMATION_X_AUTO_START=false

# 共享 Telegram Bot API 客户端
# 同一 Bot 只能由一套审核流程轮询；复用时关闭所有实例的另一套审核，并避免 webhook/其他 getUpdates 消费者。
# 共享 Telegram 客户端开关；false 时拒绝 Bot API 调用，开启本身不会启动审核循环。
TRADE_TELEGRAM_ENABLED=false
# BotFather 提供的机器人 Token；开启 Telegram 客户端时必填，微博与 X 复用此机器人。
TRADE_TELEGRAM_BOT_TOKEN=
# Telegram Bot API 基础地址；客户端会追加机器人 Token 和接口路径。
TRADE_TELEGRAM_BASE_URL=https://api.telegram.org
# Telegram HTTP 建立连接超时，单位秒。
TRADE_TELEGRAM_CONNECT_TIMEOUT_SECONDS=10
# Telegram 单次 HTTP 请求超时，单位秒。
TRADE_TELEGRAM_REQUEST_TIMEOUT_SECONDS=30
# 是否给 Telegram Bot API 请求启用 HTTP 代理。
TRADE_TELEGRAM_PROXY_ENABLED=false
# Telegram 代理主机；仅 proxy-enabled=true 时生效。
TRADE_TELEGRAM_PROXY_HOST=127.0.0.1
# Telegram 代理端口；仅 proxy-enabled=true 时生效。
TRADE_TELEGRAM_PROXY_PORT=7897

# 微博：AI 草稿 → Telegram 人工审核 → 发布
# 微博真实发布的最后一道门禁；工作流发布还需工作流/发布开关、有效授权和人工批准。
TRADE_WEIBO_LIVE_PUBLISHING_ENABLED=false
# 禁止直接发布接口绕过审核；工作流开启时即使此项 false 也不能直接发布，建议保持 true。
TRADE_WEIBO_REVIEW_REQUIRED=true
# 微博工作流总开关，控制草稿生成、审核处理与发布编排。
TRADE_WEIBO_WORKFLOW_ENABLED=false
# 允许调用共享 AI 生成微博草稿；还需工作流开启和目标 UID/热点源配置。
TRADE_WEIBO_GENERATION_ENABLED=false
# 允许处理已批准草稿；真实发布还需 live 开关及目标账号的有效授权。
TRADE_WEIBO_PUBLISHING_ENABLED=false
# 目标微博账号的数字 UID；必须与数据库保存的 OAuth 授权账号一致。
TRADE_WEIBO_TARGET_UID=
# 生成草稿使用的 RSS/Atom 热点来源地址。
TRADE_WEIBO_FEED_URL=
# 微博正文最长 Unicode 码点数；启用 Telegram 审核时不得超过 3000，确保完整展示。
TRADE_WEIBO_MAX_BODY_CHARS=280
# 每个目标账号每天最多预留的草稿生成次数，失败也计入额度；按 UTC 自然日统计。
TRADE_WEIBO_DAILY_GENERATION_LIMIT=5
# 每个目标账号每天最多预留的发布尝试次数，失败/结果不确定也计入额度；按 UTC 自然日统计。
TRADE_WEIBO_DAILY_PUBLISH_LIMIT=3
# 热点事件最大有效时长，单位小时；生成及发布时都会拒绝过期热点。
TRADE_WEIBO_EVENT_MAX_AGE_HOURS=24
# 草稿从生成预约创建起的审核/发布有效期，单位小时；修订或批准不续期，发布还受热点有效期约束。
TRADE_WEIBO_REVIEW_TTL_HOURS=6
# 距同账号最近一次发布尝试开始的最小间隔，单位秒；1800 = 30 分钟，与发布扫描周期分别生效。
TRADE_WEIBO_PUBLISH_INTERVAL_SECONDS=1800
# 生成/发布处理中状态的超时恢复阈值，单位秒；300 = 5 分钟，至少 60 秒，不是 HTTP 超时。
# 发布超时会标记结果不确定，不会自动重发。
TRADE_WEIBO_CLAIM_TIMEOUT_SECONDS=300
# 生成循环完成后等待的时间，单位毫秒；900000 = 15 分钟，仍受热点去重和日额度限制。
TRADE_WEIBO_GENERATION_FIXED_DELAY_MS=900000
# 发布扫描完成后等待的时间，单位毫秒；60000 = 1 分钟，并非每分钟一定发帖。
TRADE_WEIBO_PUBLISHING_FIXED_DELAY_MS=60000
# 微博任务启动后，三个循环首次执行前的等待时间，单位毫秒；30000 = 30 秒。
TRADE_WEIBO_INITIAL_DELAY_MS=30000
# 微博 Telegram 审核开关；还需共享 Telegram 客户端和微博工作流开启，不能与 X 审核同时启用。
TRADE_WEIBO_TELEGRAM_REVIEW_ENABLED=false
# 审核消息发送到的数字 chat ID；群聊可能为负数，这是会话 ID，不能用用户名。
TRADE_WEIBO_TELEGRAM_CHAT_ID=
# 允许操作审核按钮的数字 Telegram 用户 ID，多个用逗号分隔；与 chat ID 的含义不同。
TRADE_WEIBO_TELEGRAM_REVIEWER_USER_IDS=
# 微博短轮询完成后等待的时间，单位毫秒；5000 = 5 秒，不是长轮询超时，批准后会立即尝试发布。
TRADE_WEIBO_TELEGRAM_POLLING_FIXED_DELAY_MS=5000

# X：AI 草稿 → Telegram 人工审核 → 发布
# 复用现有 Bot 时，所有消费该 Bot 的实例均需 TRADE_WEIBO_TELEGRAM_REVIEW_ENABLED=false。
# 内容规则随新草稿保存；修改配置不会改写已有草稿，也不会跳过人工审核。
# X 管理 API 鉴权 Token，请使用长随机值；留空时接口不注册，请求头为 X-X-Admin-Token。
TRADE_X_ADMIN_TOKEN=
# X API 客户端开关；只控制 API 调用，不会启动生成/审核/发布循环。
TRADE_X_CLIENT_ENABLED=false
# OAuth 1.0a 的 Consumer Key / API Key，标识 X 开发者应用。
X_API_KEY=
# 上述 Consumer Key 对应的 Consumer Secret / API Key Secret。
X_API_SECRET=
# OAuth 1.0a 用户 Access Token，代表目标发帖账号；不是应用 Bearer Token。
X_ACCESS_TOKEN=
# 上述用户 Access Token 对应的 Access Token Secret；当前客户端不使用 OAuth 2.0 Client ID/Client Secret。
X_ACCESS_TOKEN_SECRET=
# X API 基础地址；用户身份查询和文本发布使用此地址。
TRADE_X_BASE_URL=https://api.x.com
# X HTTP 建立连接超时，单位秒。
TRADE_X_CONNECT_TIMEOUT_SECONDS=10
# X 单次 HTTP 请求超时，单位秒。
TRADE_X_REQUEST_TIMEOUT_SECONDS=30
# 是否给 X API 请求启用 HTTP 代理。
TRADE_X_PROXY_ENABLED=false
# X 代理主机；仅 proxy-enabled=true 时生效。
TRADE_X_PROXY_HOST=127.0.0.1
# X 代理端口；仅 proxy-enabled=true 时生效。
TRADE_X_PROXY_PORT=7897
# X 工作流总开关，控制生成、审核处理与发布；开启本身不会启动后台循环。
TRADE_X_WORKFLOW_ENABLED=false
# 允许共享 AI 生成 X 草稿；还需工作流开启、目标账号和内容方向配置。
TRADE_X_GENERATION_ENABLED=false
# 允许处理已批准的 X 草稿；真实发布还需 X 客户端、live 门禁及四个 OAuth 1.0a 凭据。
TRADE_X_PUBLISHING_ENABLED=false
# X 真实发布的最后一道门禁；保持 false 可生成并审核草稿，开启后仍须满足全部发布条件。
TRADE_X_LIVE_PUBLISHING_ENABLED=false
# 目标 X 账号的数字用户 ID；必须与 Access Token 所属用户一致，不是 @用户名 或 Client ID。
TRADE_X_TARGET_USER_ID=
# 成年英文读者的欲望、亲密关系与沟通方向；只影响新草稿。
TRADE_X_CONTENT_DIRECTION=面向成年英文读者，以性吸引、欲望、亲密关系与沟通为主线，辅以约会、自尊、孤独和日常关系观察；尊重同意与边界，非露骨且不以性唤起为目的
# AI 正文语言；生成时与其他内容规则一起冻结到草稿。
TRADE_X_CONTENT_LANGUAGE=English
# AI 正文语气；只影响新草稿。
TRADE_X_CONTENT_TONE=自然地道的英文，坦诚、机智、有具体细节和关系张力，温暖而不说教，不制造性别对立
# AI 额外写作约束，例如不加话题标签、采用第一人称；可留空，只影响新草稿。
TRADE_X_CONTENT_INSTRUCTIONS=三个候选采用不同形式，轮换短观点、微场景、两句对话、2至3项微清单、开放问题与短诗；可用换行和空行，每条是完整独立的单帖；不求赞求关注，不默认加标签、表情和链接，不写Markdown；虚构按正文语言标明，reviewNote用简体中文；仅自愿成年人且非露骨，不冒充性健康或心理治疗建议
# 正文最少 Unicode 码点数，NFC 规范化并去除首尾空白后统计；至少 1，且不得大于 max。
TRADE_X_CONTENT_MIN_CHARS=40
# 正文最多 Unicode 码点数，须在 min..280；另须通过 X 官方加权 280 校验，中文通常按 2 计。
TRADE_X_CONTENT_MAX_CHARS=260
# 每个目标账号每天最多预留的生成次数，失败也计入额度；按 UTC 自然日统计。
TRADE_X_DAILY_GENERATION_LIMIT=5
# 每个目标账号每天最多预留的发布尝试次数，失败/结果不确定也计入额度；按 UTC 自然日统计。
TRADE_X_DAILY_PUBLISH_LIMIT=3
# 草稿从生成预约创建起的审核/发布有效期，单位小时；修订或批准不续期，到期后不可发布。
TRADE_X_REVIEW_TTL_HOURS=6
# 距同账号最近一次发布尝试开始的最小间隔，单位秒；1800 = 30 分钟，与发布扫描周期分别生效。
TRADE_X_PUBLISH_INTERVAL_SECONDS=1800
# 生成/发布处理中状态的超时恢复阈值，单位秒；300 = 5 分钟，至少 60 秒，不是 HTTP 超时。
# 发布超时会标记结果不确定，不会自动重发。
TRADE_X_CLAIM_TIMEOUT_SECONDS=300
# 生成循环完成后等待的时间，单位毫秒；900000 = 15 分钟，同账号同 UTC 时间段预留一次并受日额度限制。
TRADE_X_GENERATION_FIXED_DELAY_MS=900000
# 发布扫描完成后等待的时间，单位毫秒；60000 = 1 分钟。
# 同时负责审核投递补偿、过期和卡住状态恢复；实际发布仍须批准、配额和间隔等条件，并非每分钟一定发帖。
TRADE_X_PUBLISHING_FIXED_DELAY_MS=60000
# X 任务启动后，三个循环首次执行前的等待时间，单位毫秒；30000 = 30 秒。
TRADE_X_INITIAL_DELAY_MS=30000
# X Telegram 审核开关；还需共享 Telegram 客户端和 X 工作流开启，复用 Bot 时关闭微博审核。
TRADE_X_TELEGRAM_REVIEW_ENABLED=false
# X 审核消息发送到的数字 chat ID，群聊可能为负数；复用微博会话时需显式填同一值。
TRADE_X_TELEGRAM_CHAT_ID=
# 允许审核 X 帖子的数字 Telegram 用户 ID，多个用逗号分隔；不会自动继承微博审核人配置。
TRADE_X_TELEGRAM_REVIEWER_USER_IDS=
# X 短轮询完成后等待的时间，单位毫秒；5000 = 5 秒，不是长轮询超时，批准后会立即尝试发布。
TRADE_X_TELEGRAM_POLLING_FIXED_DELAY_MS=5000

# OKX 策略交易与资金安全
# OKX 策略交易总开关；false 时跳过策略评估和新订单，后台循环另由自动启动/任务 API 控制。
TRADE_TRADING_ENABLED=false
# 实时策略执行模式：paper 模拟成交，live 真实执行路径；backtest 跳过实时决策，历史回测由独立 API 驱动。
TRADE_TRADING_EXECUTION_MODE=paper
# 允许发出真实新订单的二次门禁；仅 live 模式生效，仍受风控和领导租约等约束。
TRADE_TRADING_LIVE_ENABLED=false
# 启用 OKX 行情 WebSocket 订阅；交易任务启动时建立订阅，事件扫描可优先读取缓存。
TRADE_TRADING_WEBSOCKET_ENABLED=false
# 交易管理前端允许的跨域来源模式，多个用逗号分隔；按实际前端域名配置。
TRADE_TRADING_FRONTEND_ALLOWED_ORIGIN_PATTERNS=http://localhost:*
# 内存行情事件队列容量，单位为事件条数。
TRADE_TRADING_EVENT_QUEUE_CAPACITY=1024
# 队满策略：drop-oldest 丢最旧、drop-latest 丢新到事件、block 限时等待容量。
TRADE_TRADING_EVENT_QUEUE_FULL_POLICY=drop-oldest
# block 队满策略下生产者最长等待时间，单位毫秒。
TRADE_TRADING_EVENT_QUEUE_PUBLISH_TIMEOUT_MS=100
# 消费者等待下一条队列事件的时间，单位毫秒。
TRADE_TRADING_EVENT_QUEUE_POLL_TIMEOUT_MS=100
# 关闭时等待已接收事件排空的最长时间，单位毫秒；5000 = 5 秒。
TRADE_TRADING_EVENT_QUEUE_SHUTDOWN_TIMEOUT_MS=5000
# 启用 Redis 热行情缓存；缓存尽力读写，资金和订单仍以 MySQL 为准。
TRADE_TRADING_HOT_MARKET_CACHE_ENABLED=true
# 所有 Redis 交易行情键的命名前缀。
TRADE_TRADING_HOT_MARKET_CACHE_KEY_PREFIX=trade:trading:hot-market
# 最新 ticker/盘口快照的 Redis 有效期，单位毫秒；120000 = 2 分钟。
TRADE_TRADING_HOT_MARKET_CACHE_SNAPSHOT_TTL_MS=120000
# 各标的/周期 K 线集合的 Redis 有效期，单位毫秒；10800000 = 3 小时。
TRADE_TRADING_HOT_MARKET_CACHE_CANDLE_TTL_MS=10800000
# 每个标的和周期在 Redis 中最多保留的近期 K 线根数。
TRADE_TRADING_HOT_MARKET_CACHE_CANDLE_LIMIT=200
# Redis 故障后的重试冷却时间，单位毫秒；5000 = 5 秒。
TRADE_TRADING_HOT_MARKET_CACHE_RETRY_INTERVAL_MS=5000
# 启用 live 模式下的订单恢复/持仓对账；live-enabled=false 仍可对账，此循环不会重新下单。
TRADE_TRADING_RECONCILIATION_ENABLED=true
# 交易任务启动后首次对账前的等待时间，单位毫秒；5000 = 5 秒。
TRADE_TRADING_RECONCILIATION_INITIAL_DELAY_MS=5000
# 一次对账完成后的等待时间，单位毫秒；15000 = 15 秒。
TRADE_TRADING_RECONCILIATION_FIXED_DELAY_MS=15000
# 每轮最多处理的未完成本地订单数。
TRADE_TRADING_RECONCILIATION_BATCH_SIZE=100
# 连续对账失败达到此次数时触发持久化资金停止。
TRADE_TRADING_RECONCILIATION_MAX_FAILURES=3
# managed-only 只管理本系统成交；dedicated-account 要求交易所总仓位与本地管理仓位一致。
TRADE_TRADING_POSITION_OWNERSHIP=managed-only
# dedicated-account 仓位核对时允许的持仓数量偏差。
TRADE_TRADING_POSITION_MISMATCH_TOLERANCE=0.00000001
# 启用数据库领导租约；旧库需先具备 db/upgrade/trading/migration_add_okx_trading_leader_lease.sql 的结构。
TRADE_TRADING_LEADERSHIP_ENABLED=false
# 同一 OKX 账户的所有实例必须使用同一租约名称，防止多个实例同时执行交易。
TRADE_TRADING_LEADERSHIP_LEASE_NAME=okx-primary-account
# 实例唯一标识；留空时自动生成，容器部署可填 Pod/Task ID，各实例不能重复。
TRADE_TRADING_INSTANCE_ID=
# 领导租约有效时长，单位毫秒；30000 = 30 秒，应明显长于心跳间隔。
TRADE_TRADING_LEADERSHIP_LEASE_DURATION_MS=30000
# 租约续期/跟随实例尝试获取租约的间隔，单位毫秒；5000 = 5 秒。
TRADE_TRADING_LEADERSHIP_HEARTBEAT_INTERVAL_MS=5000
# 真实下单是否强制要求本实例持有有效数据库领导租约；建议保持 true。
TRADE_TRADING_LEADERSHIP_REQUIRED_FOR_LIVE=true
# 策略切换、stop/resume、手工对账共用的管理员 Token；留空时这些接口关闭，请使用长随机值。
TRADE_TRADING_OPERATOR_TOKEN=
# OKX cancel-all-after 的失联撤单等待时间，单位秒；资金停止后由对账循环持续重申。
TRADE_TRADING_DEAD_MAN_TIMEOUT_SECONDS=10
# OKX API Key；账户查询及真实下单使用。
OKX_ACCESS_KEY=
# 上述 OKX API Key 的签名 Secret Key。
OKX_SECRET_KEY=
# 创建 OKX API Key 时设置的 Passphrase。
OKX_ACCESS_PASSPHRASE=
# 是否给 OKX 客户端启用代理。
TRADE_OKX_PROXY_ENABLED=false
# OKX 代理主机；仅 proxy-enabled=true 时生效。
TRADE_OKX_PROXY_HOST=127.0.0.1
# OKX 代理端口；仅 proxy-enabled=true 时生效。
TRADE_OKX_PROXY_PORT=7897

# Polymarket 决策与下单
# Polymarket 决策模块总开关；后台循环由对应 auto-start/任务 API 启动，决策会调用 AI。
TRADE_POLYMARKET_ENABLED=false
# Polymarket 真实下单门禁；false 时只记录 dry-run，true 时仍校验市场、资金及地域限制。
TRADE_POLYMARKET_EXECUTION_ENABLED=false
# 是否给 Polymarket Gamma/CLOB HTTP 请求启用代理。
TRADE_POLYMARKET_PROXY_ENABLED=false
# Polymarket 代理主机；仅 proxy-enabled=true 时生效。
TRADE_POLYMARKET_PROXY_HOST=127.0.0.1
# Polymarket 代理端口；仅 proxy-enabled=true 时生效。
TRADE_POLYMARKET_PROXY_PORT=7897
# 下单签名使用的钱包私钥；只通过子进程环境传递给 Python 执行器。
POLYMARKET_PRIVATE_KEY=
# Polymarket CLOB API Key。
POLYMARKET_API_KEY=
# 上述 CLOB API Key 的 Secret。
POLYMARKET_API_SECRET=
# 上述 CLOB API 凭据的 Passphrase。
POLYMARKET_API_PASSPHRASE=
# 实际资金所在的钱包地址；与配置的签名类型和账户一致。
POLYMARKET_FUNDER_ADDRESS=
# Python 下单桥接脚本路径；相对路径以应用工作目录解析。
POLYMARKET_ORDER_SCRIPT=../tools/polymarket/polymarket_place_order.py

# 共享 AI 供应商
# provider/model/base-url 等在 application.yml 中选择；配置密钥不会自动发起 AI 请求。
# 共享 AI provider=deepseek 时的 API Key；是否使用由 application.yml 的 AI 配置决定。
DEEPSEEK_API_KEY=
# 共享 AI provider=gemini 时的 API Key；只需填写所选供应商的凭据。
GEMINI_API_KEY=
# 共享 AI provider=kimi 时的 Moonshot API Key。
MOONSHOT_API_KEY=
# 是否给共享 AI 请求启用代理，供各业务模块复用。
TRADE_AI_PROXY_ENABLED=false
# AI 请求代理主机；仅 proxy-enabled=true 时生效。
TRADE_AI_PROXY_HOST=127.0.0.1
# AI 请求代理端口；仅 proxy-enabled=true 时生效。
TRADE_AI_PROXY_PORT=7897

# AI 小说生成
# 允许小说生成用例调用 AI；后台循环还需自动启动开关或任务管理 API 启动。
TRADE_STORY_ENABLED=false
# 小说生成文件保存目录；相对路径以应用工作目录解析。
TRADE_STORY_OUTPUT_DIR=../story
# 是否给小说热点/榜单抓取请求启用代理，与 AI 请求代理分别配置。
TRADE_STORY_TREND_PROXY_ENABLED=false
# 小说热点抓取代理主机；仅 trend-proxy-enabled=true 时生效。
TRADE_STORY_TREND_PROXY_HOST=127.0.0.1
# 小说热点抓取代理端口；仅 trend-proxy-enabled=true 时生效。
TRADE_STORY_TREND_PROXY_PORT=7897

# 集市会话与阿里云 OSS 图片上传
# 集市登录会话有效期，单位天。
TRADE_MARKETPLACE_SESSION_RETENTION_DAYS=30
# 阿里云 AccessKey ID，用于调用 STS 获取临时 OSS 上传凭据。
ALIBABA_CLOUD_ACCESS_KEY_ID=
# 上述阿里云 AccessKey 对应的 Secret。
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# STS AssumeRole 的 RAM 角色 ARN，用于授权临时上传凭据。
TRADE_MARKETPLACE_OSS_ROLE_ARN=
# 接收集市图片上传的 OSS Bucket 名称。
TRADE_MARKETPLACE_OSS_BUCKET=
# OSS 区域，例如 cn-hangzhou 或 oss-cn-hangzhou。
TRADE_MARKETPLACE_OSS_REGION=
# 图片访问地址前缀；留空时由 Bucket/Region 生成 OSS 地址，可配置 CDN 域名。
TRADE_MARKETPLACE_OSS_PUBLIC_BASE_URL=
# 阿里云 STS 服务基础地址。
TRADE_MARKETPLACE_OSS_STS_ENDPOINT=https://sts.aliyuncs.com
# 临时 OSS 上传凭据有效期，单位秒；900 = 15 分钟，代码限制在 900..3600。
TRADE_MARKETPLACE_OSS_DURATION_SECONDS=900
# OSS 图片对象键前缀。
TRADE_MARKETPLACE_OSS_KEY_PREFIX=marketplace

# 文字游戏与微博 OAuth/管理接口
# 文字游戏管理接口 Token；留空时接口关闭，请求头为 X-Admin-Token。
TRADE_TEXT_GAME_ADMIN_TOKEN=
# 应用启动时导入内置剧情；已有对应版本时跳过，不是定时生成开关。
TRADE_TEXT_GAME_SEED_ENABLED=true
# 微博 OAuth 应用 App Key / Client ID。
WEIBO_CLIENT_ID=
# 上述微博应用的 App Secret / Client Secret。
WEIBO_CLIENT_SECRET=
# 微博 OAuth 授权回调地址，需与平台配置一致。
WEIBO_REDIRECT_URI=
# 微博管理接口 Token，请使用长随机值；请求头为 X-Weibo-Admin-Token。
TRADE_WEIBO_ADMIN_TOKEN=
# 是否给微博 OAuth 和 API 请求启用代理。
TRADE_WEIBO_PROXY_ENABLED=false
# 微博代理主机；仅 proxy-enabled=true 时生效。
TRADE_WEIBO_PROXY_HOST=127.0.0.1
# 微博代理端口；仅 proxy-enabled=true 时生效。
TRADE_WEIBO_PROXY_PORT=7897

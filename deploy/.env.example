# Compose interpolation only. Never commit the real deploy/.env.
# Copy this file on the Ubuntu server; passwords are REQUIRED and intentionally empty.
COMPOSE_PROJECT_NAME=trade-production
DATA_VOLUME_PREFIX=trade-production
# Default private access: these ports bind ONLY to the server's loopback.
# Use the same ports on the computer's SSH local forwards.
COCKPIT_LOCAL_PORT=18080
X_CONSOLE_LOCAL_PORT=18081

MYSQL_IMAGE=mysql:8.0
MYSQL_DATABASE=trade_system
MYSQL_USER=trade
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
REDIS_IMAGE=redis:7-alpine
REDIS_PASSWORD=

# Paths are relative to the repository root (compose.prod.yaml), NOT this file.
BACKEND_ENV_FILE=./deploy/backend.env
SECRETS_DIRECTORY=./deploy/secrets

EGRESS_SSH_HOST=replace-with-german-vps-host
EGRESS_SSH_PORT=22
EGRESS_SSH_USER=trade-proxy
EGRESS_REMOTE_PORT=3128
NGINX_IMAGE=nginx:1.30.6-alpine

# Starting memory limits; inspect real RSS, heap, MySQL and queue metrics after deployment.
MYSQL_MEMORY_LIMIT=768m
REDIS_MEMORY_LIMIT=192m
BACKEND_MEMORY_LIMIT=1g
COCKPIT_MEMORY_LIMIT=512m
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=65.0 -XX:+ExitOnOutOfMemoryError

# Optional monitoring profile, bound to server loopback; keep a separate strong password.
PROMETHEUS_IMAGE=prom/prometheus:v3.12.0
PROMETHEUS_PORT=9090
GRAFANA_IMAGE=grafana/grafana:13.1.0
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
ALERTMANAGER_IMAGE=prom/alertmanager:v0.30.0
ALERTMANAGER_PORT=9093
ALERTMANAGER_WEBHOOK_URL_FILE=./deploy/secrets/alertmanager_webhook_url

# Optional public HTTPS, only with release.sh --access public.
# Private mode needs no domain, TLS files or public Web ports.
# COCKPIT_DOMAIN=trade.example.com
# X_CONSOLE_DOMAIN=x.example.com
# HTTP_BIND_ADDRESS=0.0.0.0
# HTTP_PORT=80
# HTTPS_BIND_ADDRESS=0.0.0.0
# HTTPS_PORT=443
# TLS_DIRECTORY=./deploy/secrets/tls
# ACME_DIRECTORY=./deploy/acme

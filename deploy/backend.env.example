# Runtime-only application variables. Compose loads this file using format: raw.
# Do not quote values or put shell commands here; literal $ characters are preserved.
# Required target identifiers and credentials stay empty until configured ON THE SERVER.
# Production Compose forces authentication on and mounts the bcrypt operator file.
# Production Compose also forces Flyway on and basic SQL initialization off.
# Schema upgrades are packaged in the backend image; do not run db/upgrade blindly.
TRADE_MANAGEMENT_AUTH_ENABLED=true
TRADE_AUTOMATION_TRADING_AUTO_START=true
TRADE_TRADING_ENABLED=true
TRADE_TRADING_EXECUTION_MODE=paper
TRADE_TRADING_LIVE_ENABLED=false
TRADE_TRADING_WEBSOCKET_ENABLED=true
TRADE_TRADING_WEBSOCKET_STALE_TIMEOUT_MS=30000
TRADE_TRADING_HOT_MARKET_CACHE_CANDLE_FRESHNESS_MS=15000
TRADE_TRADING_HOT_MARKET_CACHE_ENABLED=true
TRADE_OKX_PROXY_ENABLED=true
TRADE_OKX_WS_PUBLIC_URL=wss://ws.okx.com/ws/v5/public
TRADE_OKX_WS_BUSINESS_URL=wss://ws.okx.com/ws/v5/business
TRADE_OKX_WS_PRIVATE_URL=wss://ws.okx.com/ws/v5/private
# PAPER decisions use public market data and their own persisted account.
# Credentials are only needed for LIVE account access; keep live execution disabled.
OKX_ACCESS_KEY=
OKX_SECRET_KEY=
OKX_ACCESS_PASSPHRASE=

TRADE_AUTOMATION_X_AUTO_START=true
TRADE_X_CLIENT_ENABLED=true
TRADE_X_WORKFLOW_ENABLED=true
TRADE_X_GENERATION_ENABLED=true
TRADE_X_TELEGRAM_REVIEW_ENABLED=true
TRADE_X_PUBLISHING_ENABLED=true
TRADE_X_LIVE_PUBLISHING_ENABLED=true
TRADE_X_GENERATION_FIXED_DELAY_MS=10800000
TRADE_X_DAILY_GENERATION_LIMIT=8
TRADE_X_DAILY_PUBLISH_LIMIT=8
TRADE_X_PUBLISH_INTERVAL_SECONDS=1800
TRADE_X_REVIEW_TTL_HOURS=24
TRADE_X_PROXY_ENABLED=true
TRADE_X_TARGET_USER_ID=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

TRADE_TELEGRAM_ENABLED=true
TRADE_TELEGRAM_PROXY_ENABLED=true
TRADE_TELEGRAM_BOT_TOKEN=
TRADE_X_TELEGRAM_CHAT_ID=
TRADE_X_TELEGRAM_REVIEWER_USER_IDS=

TRADE_AI_PROVIDER=deepseek
TRADE_AI_MODEL=deepseek-flash
TRADE_AI_BASE_URL=https://api.deepseek.com
TRADE_AI_API_KEY_ENV_NAME=DEEPSEEK_API_KEY
TRADE_AI_PROXY_ENABLED=false
DEEPSEEK_API_KEY=

TRADE_AUTOMATION_POLYMARKET_AUTO_START=false
TRADE_POLYMARKET_ENABLED=false
TRADE_POLYMARKET_EXECUTION_ENABLED=false
TRADE_POLYMARKET_PROXY_ENABLED=false
TRADE_AUTOMATION_WEIBO_AUTO_START=false
TRADE_WEIBO_WORKFLOW_ENABLED=false
TRADE_WEIBO_GENERATION_ENABLED=false
TRADE_WEIBO_PUBLISHING_ENABLED=false
TRADE_WEIBO_LIVE_PUBLISHING_ENABLED=false
TRADE_WEIBO_TELEGRAM_REVIEW_ENABLED=false
TRADE_AUTOMATION_STORY_AUTO_START=false
TRADE_STORY_ENABLED=false

# Trading AI advisor: all switches stay off until credentials and simulation are configured.
# Reuses TRADE_AI_* and the selected provider's API key; never needs OKX private credentials in PAPER.
TRADE_AUTOMATION_TRADING_AI_AUTO_START=false
TRADE_TRADING_AI_ENABLED=false
TRADE_TRADING_AI_AUTO_APPLY=false
# Calendar-day objective with 30-minute reassessment. Uses trade.trading.risk.daily-zone.
TRADE_TRADING_AI_REVIEW_INTERVAL_MS=1800000
# Flexible target: one complete open-to-flat round trip counts once. Never force trades.
TRADE_TRADING_AI_TARGET_MIN_CLOSED_TRADES_PER_DAY=5
TRADE_TRADING_AI_TARGET_MAX_CLOSED_TRADES_PER_DAY=8
TRADE_TRADING_AI_MAX_REVIEW_AGE_SECONDS=300
TRADE_TRADING_AI_CANDLE_COUNT=96
TRADE_TRADING_AI_MINIMUM_CONFIDENCE=0.80
# Dedicated bot, different from TRADE_TELEGRAM_BOT_TOKEN / X review. No fallback to shared chat/token.
TRADE_TRADING_AI_TELEGRAM_ENABLED=false
TRADE_TRADING_AI_TELEGRAM_BOT_TOKEN=
TRADE_TRADING_AI_TELEGRAM_CHAT_ID=
TRADE_TRADING_AI_TELEGRAM_COOLDOWN_MS=86400000
TRADE_TRADING_AI_TELEGRAM_BASE_URL=https://api.telegram.org
TRADE_TRADING_AI_TELEGRAM_CONNECT_TIMEOUT_SECONDS=10
TRADE_TRADING_AI_TELEGRAM_REQUEST_TIMEOUT_SECONDS=30
TRADE_TRADING_AI_TELEGRAM_PROXY_ENABLED=false
TRADE_TRADING_AI_TELEGRAM_PROXY_HOST=127.0.0.1
TRADE_TRADING_AI_TELEGRAM_PROXY_PORT=7897
